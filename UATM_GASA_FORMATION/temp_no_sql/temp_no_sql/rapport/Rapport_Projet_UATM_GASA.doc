│   ├── notifications.php
│   ├── profil.php
│   ├── rapports.php
│   ├── lire.php
│   └── like.php
├── sql/
│   ├── schema.sql
│   └── filieres.sql
└── index.php</div>

<h3>4.5 Creation Base MySQL</h3>
<p>La base de donnees <strong>uatm_gasa_memoires</strong> contient 12 tables :</p>
<ul>
<li>roles, utilisateurs, filieres, memoires, validations</li>
<li>commentaires, likes, notifications, rapports, historiques, archives</li>
</ul>
<p>Voir annexe SQL pour le code complet.</p>

<h3>4.6 Securite implementee</h3>
<table>
<tr><th>Menace</th><th>Protection</th></tr>
<tr><td>Injection SQL</td><td>PDO + Prepared Statements</td></tr>
<tr><td>CSRF</td><td>Token CSRF sur chaque formulaire</td></tr>
<tr><td>XSS</td><td>Fonction sanitize() = htmlspecialchars()</td></tr>
<tr><td>Mot de passe</td><td>password_hash() + password_verify()</td></tr>
<tr><td>Upload</td><td>Verification MIME + extension + taille</td></tr>
<tr><td>Access</td><td>RBAC par role</td></tr>
<tr><td>Sessions</td><td>Cookies httponly + samesite</td></tr>
</table>

