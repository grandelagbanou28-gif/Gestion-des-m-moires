{
  "version": 2,
  "builds": [
    { "src": "index.php", "use": "@vercel/php" },
    { "src": "config/database.php", "use": "@vercel/php" },
    { "src": "includes/functions.php", "use": "@vercel/php" },
    { "src": "includes/header.php", "use": "@vercel/php" },
    { "src": "includes/footer.php", "use": "@vercel/php" },
    { "src": "auth/login.php", "use": "@vercel/php" },
    { "src": "auth/register.php", "use": "@vercel/php" },
    { "src": "auth/logout.php", "use": "@vercel/php" },
    { "src": "auth/session.php", "use": "@vercel/php" },
    { "src": "etudiant/index.php", "use": "@vercel/php" },
    { "src": "etudiant/deposer.php", "use": "@vercel/php" },
    { "src": "etudiant/memoires.php", "use": "@vercel/php" },
    { "src": "etudiant/voir.php", "use": "@vercel/php" },
    { "src": "etudiant/modifier.php", "use": "@vercel/php" },
    { "src": "etudiant/supprimer.php", "use": "@vercel/php" },
    { "src": "professeur/index.php", "use": "@vercel/php" },
    { "src": "professeur/memoires.php", "use": "@vercel/php" },
    { "src": "professeur/voir.php", "use": "@vercel/php" },
    { "src": "admin/index.php", "use": "@vercel/php" },
    { "src": "admin/utilisateurs.php", "use": "@vercel/php" },
    { "src": "admin/ajouter_utilisateur.php", "use": "@vercel/php" },
    { "src": "admin/modifier_utilisateur.php", "use": "@vercel/php" },
    { "src": "admin/supprimer_utilisateur.php", "use": "@vercel/php" },
    { "src": "admin/filieres.php", "use": "@vercel/php" },
    { "src": "admin/ajouter_filiere.php", "use": "@vercel/php" },
    { "src": "admin/modifier_filiere.php", "use": "@vercel/php" },
    { "src": "admin/supprimer_filiere.php", "use": "@vercel/php" },
    { "src": "admin/historique.php", "use": "@vercel/php" },
    { "src": "dashboard/index.php", "use": "@vercel/php" },
    { "src": "dashboard/directeur.php", "use": "@vercel/php" },
    { "src": "pages/bibliotheque.php", "use": "@vercel/php" },
    { "src": "pages/notifications.php", "use": "@vercel/php" },
    { "src": "pages/profil.php", "use": "@vercel/php" },
    { "src": "pages/rapports.php", "use": "@vercel/php" },
    { "src": "pages/lire.php", "use": "@vercel/php" },
    { "src": "pages/like.php", "use": "@vercel/php" },
    { "src": "controllers/upload.php", "use": "@vercel/php" },
    { "src": "controllers/likes.php", "use": "@vercel/php" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/index.php" },
    { "src": "^/config/(.*)$", "dest": "/config/$1" },
    { "src": "^/includes/(.*)$", "dest": "/includes/$1" },
    { "src": "^/auth/(.*)$", "dest": "/auth/$1" },
    { "src": "^/etudiant/?$", "dest": "/etudiant/index.php" },
    { "src": "^/etudiant/(.*)$", "dest": "/etudiant/$1" },
    { "src": "^/professeur/?$", "dest": "/professeur/index.php" },
    { "src": "^/professeur/(.*)$", "dest": "/professeur/$1" },
    { "src": "^/admin/?$", "dest": "/admin/index.php" },
    { "src": "^/admin/(.*)$", "dest": "/admin/$1" },
    { "src": "^/dashboard/?$", "dest": "/dashboard/index.php" },
    { "src": "^/dashboard/(.*)$", "dest": "/dashboard/$1" },
    { "src": "^/pages/(.*)$", "dest": "/pages/$1" },
    { "src": "^/controllers/(.*)$", "dest": "/controllers/$1" },
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/(.*)$", "dest": "/index.php" }
  ],
  "outputDirectory": "."
}
